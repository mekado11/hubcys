// Firestore Security Rules — Hubcys
// Deploy with: firebase deploy --only firestore:rules
//
// Key principles:
//   1. All reads/writes require authentication
//   2. Users can only read/write their own company's data (company_id scoping)
//   3. Super admin authority comes only from an operator-managed Auth claim
//   4. Per-user collections (training, notifications) scoped by user_email
//
// WARNING: These rules are the primary security layer. Client-side checks are
// defence-in-depth only — never rely on them as the sole protection.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // Fetch caller's user document to get company_id and role.
    // Uses exists() guard so missing documents don't throw.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function callerCompanyId() {
      return callerProfile().company_id;
    }

    function operatorRevocationPath() {
      return /databases/$(database)/documents/operator_revocations/$(uid());
    }

    // The Auth claim is the only source of global authority. A claim carried by an
    // ID token from a session that began before an operator revocation is rejected,
    // so revocation takes effect immediately instead of when the token expires.
    function isSuperAdmin() {
      return isAuthed()
        && request.auth.token.get('is_super_admin', false) == true
        && (!exists(operatorRevocationPath())
          || request.auth.token.auth_time > get(operatorRevocationPath()).data.revoked_at_seconds);
    }

    function sameCompany(resourceCompanyId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && resourceCompanyId is string && resourceCompanyId.size() > 0
        && callerProfile().get('approval_status', '') == 'approved'
        && callerCompanyId() == resourceCompanyId;
    }

    function sameCompanyUpdate() {
      return sameCompany(resource.data.company_id)
        && request.resource.data.company_id == resource.data.company_id;
    }

    function isCompanyAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && callerProfile().company_role == 'admin'
        && callerProfile().approval_status == 'approved';
    }

    function safeSelfProfileCreate(userId) {
      return uid() == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'email', 'full_name', 'approval_status', 'company_onboarding_completed',
          'disclaimer_acknowledged', 'subscription_tier', 'company_role',
          'is_super_admin', 'created_date', 'updated_date'
        ])
        && request.resource.data.is_super_admin == false
        && request.resource.data.approval_status == 'approved'
        && request.resource.data.company_onboarding_completed == false
        && request.resource.data.company_role == 'admin'
        && request.resource.data.subscription_tier == 'free_trial'
        && !request.resource.data.keys().hasAny(['company_id', 'app_role']);
    }

    function safeSelfProfileUpdate(userId) {
      return uid() == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'full_name', 'disclaimer_acknowledged', 'onboarding_completed',
          'role_type', 'company_name', 'company_description',
          'company_industry', 'company_size', 'updated_date'
        ]);
    }

    function canClaimCreatedCompany(userId) {
      return uid() == userId
        && !resource.data.keys().hasAny(['company_id'])
        && resource.data.approval_status == 'approved'
        && resource.data.company_role == 'admin'
        && request.resource.data.is_super_admin == false
        && request.resource.data.company_role == 'admin'
        && request.resource.data.approval_status == 'approved'
        && request.resource.data.company_onboarding_completed == true
        && exists(/databases/$(database)/documents/company/$(request.resource.data.company_id))
        && get(/databases/$(database)/documents/company/$(request.resource.data.company_id)).data.created_by_uid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'company_id', 'company_name', 'company_access_code',
          'company_description', 'company_industry', 'company_size',
          'company_onboarding_completed', 'company_role',
          'approval_status', 'updated_date'
        ]);
    }

    function canAdministerCompanyUser(userId) {
      return uid() != userId
        && isCompanyAdmin()
        && sameCompany(resource.data.company_id)
        && request.resource.data.company_id == resource.data.company_id
        && request.resource.data.company_role in ['admin', 'member']
        && request.resource.data.approval_status in ['approved', 'pending', 'rejected', 'suspended', 'banned']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approval_status', 'company_role', 'approved_by',
          'approved_date', 'rejection_reason', 'updated_date'
        ]);
    }

    // Owner by user_email (training progress, badges, notifications, etc.)
    function isOwnerByEmail(resourceUserEmail) {
      return isAuthed() && request.auth.token.email_verified == true
        && userEmail() == resourceUserEmail;
    }

    function safeCompanyCreate() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && !callerProfile().keys().hasAny(['company_id'])
        && callerProfile().approval_status == 'approved'
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.admin_user_email == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.get('subscription_tier', 'free_trial') == 'free_trial'
        && request.resource.data.keys().hasOnly([
          'name', 'access_code', 'admin_user_email', 'description', 'industry',
          'size', 'status', 'subscription_tier', 'created_by_uid',
          'created_date', 'updated_date'
        ]);
    }

    function canEditCompany(companyId) {
      return isCompanyAdmin() && sameCompany(companyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'industry', 'size', 'updated_date'
        ]);
    }

    function ownsUnclaimedCompany() {
      return isAuthed() && resource.data.get('created_by_uid', '') == uid()
        && !callerProfile().keys().hasAny(['company_id'])
        && callerProfile().approval_status == 'approved';
    }

    function personalOrCompany(data) {
      return sameCompany(data.get('company_id', null)) ||
        (isOwnerByEmail(data.get('user_email', ''))
          && (!data.keys().hasAny(['company_id']) || sameCompany(data.company_id)));
    }

    function safePersonalCreate() {
      return isOwnerByEmail(request.resource.data.user_email)
        && (!request.resource.data.keys().hasAny(['company_id'])
          || sameCompany(request.resource.data.company_id))
        && request.resource.data.get('user_id', uid()) == uid();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthed() && (uid() == userId || sameCompany(resource.data.company_id) || isSuperAdmin());
      allow create: if isAuthed() && safeSelfProfileCreate(userId);
      allow update: if isAuthed() && (
        safeSelfProfileUpdate(userId) ||
        canClaimCreatedCompany(userId) ||
        canAdministerCompanyUser(userId) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ── Company-scoped collections ─────────────────────────────────────────────
    // Pattern: only members of the same company can access their data.
    // Rules cover both singular form (what the entity factory writes) and
    // plural form (kept for backwards compat / direct Firestore access).

    // Assessments
    match /assessment/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /assessments/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Compliance Frameworks
    match /compliance_framework/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /compliance_frameworks/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Compliance Controls
    match /compliance_control/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /compliance_controls/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Action Items
    match /action_item/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /action_items/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Incidents
    match /incident/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /incidents/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Incident Notes
    match /incident_note/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Policies
    match /policy/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /policies/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Risks
    match /risk/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /risks/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // BIA (entity factory generates 'b_i_a')
    match /b_i_a/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /b_i_as/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Tabletop Exercises
    match /tabletop_exercise/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /tabletop_exercises/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Exercise Participants
    match /exercise_participant/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Teams
    match /team/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /teams/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Team Members
    match /team_member/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    match /team_members/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // ETSI Assessments
    match /etsi_assessment/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Evidence
    match /evidence/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // PCI Scope
    match /pci_scope/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Regulatory Requirements
    match /regulatory_requirement/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Org Units
    match /org_unit/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Asset Types
    match /asset_type/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Subtasks
    match /subtask/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Comments
    match /comment/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Editing Sessions (collaborative editing)
    match /editing_session/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Smart Analysis Config
    match /smart_analysis_config/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // IOC Analyzer Config (entity generates 'i_o_c_analyzer_config')
    match /i_o_c_analyzer_config/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }
    // Backwards-compat alias
    match /ioc_analyzer_config/{docId} {
      allow read, delete: if isAuthed() && (sameCompany(resource.data.company_id) || isSuperAdmin());
      allow update: if isAuthed() && (sameCompanyUpdate() || isSuperAdmin());
      allow create: if isAuthed() && (sameCompany(request.resource.data.company_id) || isSuperAdmin());
    }

    // Smart Consultation (AI chat sessions — per company + per user)
    match /smart_consultation/{docId} {
      allow read, delete: if personalOrCompany(resource.data) || isSuperAdmin();
      allow update: if isSuperAdmin() || (personalOrCompany(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['company_id', 'user_email', 'user_id']));
      allow create: if isAuthed() && (
        sameCompany(request.resource.data.company_id) ||
        isSuperAdmin()
      );
    }

    // ── Companies ─────────────────────────────────────────────────────────────
    match /company/{companyId} {
      allow get: if isAuthed() && (sameCompany(companyId) || ownsUnclaimedCompany() || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if safeCompanyCreate();
      allow update: if canEditCompany(companyId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    match /companies/{companyId} {
      allow get: if isAuthed() && (sameCompany(companyId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if canEditCompany(companyId) || isSuperAdmin();
    }

    // ── Global / admin-only collections ───────────────────────────────────────
    match /threat_advisory/{docId} {
      allow read: if isAuthed();
      allow write: if isSuperAdmin();
    }
    match /threat_advisories/{docId} {
      allow read: if isAuthed();
      allow write: if isSuperAdmin();
    }

    match /training_video/{docId} {
      allow read: if isAuthed();
      allow write: if isSuperAdmin();
    }
    match /training_videos/{docId} {
      allow read: if isAuthed();
      allow write: if isSuperAdmin();
    }

    match /feature_request/{docId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthed();
      allow update, delete: if isSuperAdmin();
    }
    match /feature_requests/{docId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthed();
      allow update, delete: if isSuperAdmin();
    }

    // ── Per-user collections ───────────────────────────────────────────────────
    // These use user_email (not UID) for ownership — match the entity fields.

    match /training_progress/{docId} {
      allow read, delete: if personalOrCompany(resource.data) || isSuperAdmin();
      allow update: if isSuperAdmin() || (personalOrCompany(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['company_id', 'user_email', 'user_id']));
      allow create: if safePersonalCreate() || isSuperAdmin();
    }

    match /training_badge/{docId} {
      allow read, delete: if personalOrCompany(resource.data) || isSuperAdmin();
      allow update: if isSuperAdmin() || (personalOrCompany(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['company_id', 'user_email', 'user_id']));
      allow create: if safePersonalCreate() || isSuperAdmin();
    }

    match /video_progress/{docId} {
      allow read, delete: if personalOrCompany(resource.data) || isSuperAdmin();
      allow update: if isSuperAdmin() || (personalOrCompany(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['company_id', 'user_email', 'user_id']));
      allow create: if safePersonalCreate() || isSuperAdmin();
    }

    match /ioc_feedback/{docId} {
      allow read, delete: if personalOrCompany(resource.data) || isSuperAdmin();
      allow update: if isSuperAdmin() || (personalOrCompany(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['company_id', 'user_email', 'user_id']));
      allow create: if safePersonalCreate() || isSuperAdmin();
    }

    match /notification/{docId} {
      allow read, delete: if personalOrCompany(resource.data) || isSuperAdmin();
      allow update: if isSuperAdmin() || (personalOrCompany(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['company_id', 'user_email', 'user_id']));
      allow create: if safePersonalCreate() || isSuperAdmin();
    }

    // V2 is server-command-only. Legacy profile flags confer NO access here.
    // Admin SDK command services must enforce their own transactional policy.
    match /organizations/{document=**} {
      allow read, write: if false;
    }

    // Operator revocations are written only by the Admin SDK operator CLI.
    match /operator_revocations/{document=**} {
      allow read, write: if false;
    }

    // Preserve legacy admin fallback outside the explicitly isolated roots.
    // A broad recursive allow would otherwise override the denies above.
    match /{rootCollection}/{document=**} {
      allow read, write: if !(rootCollection in ['organizations', 'operator_revocations']) && isSuperAdmin();
    }
  }
}
