{
  "name": "ExerciseInject",
  "type": "object",
  "properties": {
    "exercise_id": {
      "type": "string",
      "description": "ID of the tabletop exercise"
    },
    "inject_sequence": {
      "type": "number",
      "description": "Order of this inject in the exercise"
    },
    "inject_type": {
      "type": "string",
      "enum": [
        "Initial_Scenario",
        "Information_Update",
        "Escalation",
        "External_Pressure",
        "System_Status",
        "Stakeholder_Query",
        "Media_Inquiry",
        "Regulatory_Contact",
        "Technical_Finding"
      ],
      "description": "Type of inject"
    },
    "inject_content": {
      "type": "string",
      "description": "Content of the inject message"
    },
    "trigger_condition": {
      "type": "string",
      "description": "Condition that triggers this inject (time-based, response-based, or manual)"
    },
    "target_participants": {
      "type": "string",
      "description": "Specific participants this inject is directed to"
    },
    "inject_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this inject was delivered during the exercise"
    },
    "participant_responses": {
      "type": "string",
      "description": "JSON string containing participant responses to this inject"
    },
    "llm_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this inject was generated by the LLM"
    },
    "facilitator_notes": {
      "type": "string",
      "description": "Facilitator notes about this inject"
    }
  },
  "required": [
    "exercise_id",
    "inject_sequence",
    "inject_type",
    "inject_content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "company_id": "{{user.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "company_id": "{{user.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}