{
  "name": "hubcys",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:review": "tsc -p tsconfig.v2.json && node .v2-build/scripts/generate-review-fixture.js && vite build --mode review",
    "lint": "eslint . --quiet",
    "lint:v2": "eslint src/v2 src/App.jsx review/Preview.jsx --quiet",
    "test:ui": "playwright test",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "typecheck:v2": "tsc -p tsconfig.v2.json --noEmit",
    "test:v2": "tsc -p tsconfig.v2.json && node --test .v2-build/tests/v2/*.test.js",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:emulator": "firebase emulators:exec --project demo-hubcys-v2 --config firebase.emulator.json --only auth,firestore \"npm run test:emulator:inner\"",
    "test:emulator:inner": "node scripts/assert-local-emulators.mjs && tsc -p tsconfig.v2.json && NODE_ENV=test FIREBASE_PROJECT_ID=demo-hubcys-v2 node --test --test-concurrency=1 .v2-build/tests/emulator/*.test.js",
    "preview": "vite preview"
  },
